SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_PROJECT_REF=<ref>
PGPASSWORD=
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
ANTHROPIC_API_KEY=sk-ant-...
SAM_API_KEY=
VERITY_MODEL=claude-sonnet-5
# console gate for web/.env.local
VERITY_CONSOLE_PASSWORD=
VERITY_SESSION_SECRET=
VERITY_DUCKDB=data/verity.duckdb

# Blue Button 2.0 (sandbox app registered at https://sandbox.bluebutton.cms.gov). Scopes are space separated.
BLUEBUTTON_CLIENT_ID=
BLUEBUTTON_CLIENT_SECRET=
BLUEBUTTON_REDIRECT_URI=http://localhost:8000/bluebutton/callback
BLUEBUTTON_SCOPES=openid profile patient/Patient.rs patient/Coverage.rs patient/ExplanationOfBenefit.rs
BLUEBUTTON_BASE_URL=https://api.bluebutton.cms.gov
# BLUEBUTTON_ALLOW_SANDBOX=1   # integration testing only; the sandbox serves synthetic beneficiaries

# SAM.gov (free key from https://sam.gov/profile/details, "Public API Key")
SAM_API_KEY=
